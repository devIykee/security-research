[package]
name = "satrush-client"
version = "0.1.12"
homepage = "https://satrush.io"
description = "Rust client to interact with SatRush's on-chain program."
license-file = "LICENSE"
repository = "https://github.com/Sat-Rush/satrush-sdk"
keywords = ["solana", "crypto"]
edition = "2021"
include = ["src/*"]

[lib]
crate-type = ["cdylib", "lib"]

[features]
default = ["fetch"]
anchor = ["dep:anchor-lang"]
anchor-idl-build = []
serde = ["dep:serde", "dep:serde_with"]
fetch = []
solana-v1 = []

[dependencies]
# Anchor
anchor-lang = { version = "1.1.2", optional = true }

# Solana
solana-address = { version = "^2.6.1" }
solana-account = { version = "^3.2.0" }
solana-rpc-client = { version = "3.1.14" }
solana-rpc-client-api = { version = "3.1.14" }
solana-account-decoder = { version = "^3.1.14" }
solana-account-info = { version = "^3.1.1" }
solana-instruction = { version = "^3.0.0" }
solana-pubkey = { version = "^3.0.0" }
solana-program-error = { version = "^3.0.1" }
solana-cpi = { version = "^3.1.0" }
solana-message = { version = "3.0.1" }
solana-address-lookup-table-interface = { version = "3.0.1", features = ["bincode", "bytemuck"] }

# Other
serde = { version = "1.0", features = ["derive"], optional = true }
serde_with = { version = "3.12", optional = true }
borsh = { version = "1.5.5" }
thiserror = { version = "2.0.18" }
num-derive = { version = "0.4.2" }
num-traits = { version = "0.2.19" }

[dev-dependencies]
anchor-lang = "1.1.2"
borsh = { version = "1.5.5" }
litesvm = "0.13.1"
solana-kite = "0.4.0"
solana-transaction = "3.0.2"
solana-signer = "3.0.0"
solana-keypair = "3.0.1"
solana-sdk-ids = "3.1.0"
spl-token = "9.0.0"
spl-associated-token-account = "8.0.0"
# Surfpool mainnet-fork integration test (gated by SURFPOOL_JUPITER=1).
solana-commitment-config = "3.0.0"
solana-compute-budget-interface = "3.0.0"
ureq = { version = "2", features = ["json"] }
serde_json = "1"
base64 = "0.22"
hex = "0.4"
